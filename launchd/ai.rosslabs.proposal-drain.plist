<!-- Weekly cross-repo proposal-drain scan. Writes the digest + posts a notification.
     Never auto-applies. This file is a template: launchd does not expand $HOME, so
     __BUILD_LOOP_DIR__ and __HOME__ are filled in at install time.
     Install from the repo root: chmod +x scripts/drain_proposals.py;
     mkdir -p "$HOME/.local/state/build-loop-drain";
     sed -e "s|__BUILD_LOOP_DIR__|$PWD|g" -e "s|__HOME__|$HOME|g" launchd/ai.rosslabs.proposal-drain.plist
       > ~/Library/LaunchAgents/ai.rosslabs.proposal-drain.plist; then
     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/ai.rosslabs.proposal-drain.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.rosslabs.proposal-drain</string>

  <key>Program</key>
  <string>__BUILD_LOOP_DIR__/scripts/drain_proposals.py</string>

  <key>ProgramArguments</key>
  <array>
    <string>__BUILD_LOOP_DIR__/scripts/drain_proposals.py</string>
    <string>scan</string>
    <string>--notify</string>
  </array>

  <!-- Weekly: Monday 09:00. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>1</integer>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <!-- Catch up on next login if the machine was asleep at the scheduled time. -->
  <key>RunAtLoad</key>
  <false/>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>ProcessType</key>
  <string>Background</string>

  <key>StandardOutPath</key>
  <string>__HOME__/.local/state/build-loop-drain/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.local/state/build-loop-drain/launchd.log</string>
</dict>
</plist>
