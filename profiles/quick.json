{
  "schema": "build-loop.profile.v1",
  "name": "quick",
  "description": "Lean Claude session for small, bounded edits. Loads no user, project or local settings, so no plugins, hooks, MCP servers or CLAUDE.md: start-up is fastest. The policy of this profile is a placeholder and not a safety gate.",
  "agent": {
    "host": "claude_code",
    "command": "claude-agent-acp",
    "args": [],
    "env": {},
    "model_env": "ANTHROPIC_MODEL",
    "mode": "default",
    "session_meta": {
      "claudeCode": {
        "options": {
          "settingSources": [],
          "settings": {"permissions": {"ask": ["Bash","Read","Edit","Write","NotebookEdit","Glob","Grep","WebFetch","WebSearch","Agent","Skill"]}}
        }
      }
    }
  },
  "sign_in": {"mode": "subscription", "unset_env": ["ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN"]},
  "models": {
    "default": {"segment": "agentic_execution", "tier": "T3"},
    "plan": {"segment": "generative_reasoning", "tier": "T2"},
    "lookup": {"segment": "generative_reasoning", "tier": "T4"}
  },
  "instructions": {
    "method": true,
    "append": ["This is a quick-fix session: make the smallest change that solves the task, verify it, and stop."]
  },
  "policy": "slice1-experimental",
  "mcp_servers": [],
  "skills": [],
  "deadline_seconds": 300
}
