# OS
.DS_Store
Thumbs.db

# Runtime data (created in consumer projects)
.build-loop/
.claude/
.agent-rally-point/

# build-loop backlog (added by `backlog.py adopt` — keep so the backlog travels)
!/.build-loop/
/.build-loop/*
# NOT un-ignored: this repo is PUBLIC. references/public-repository-documentation
# -boundary.md §3 denies "deferred-work lists" AND ".build-loop/ working state",
# and scripts/hooks check_runtime_memory_tracking blocks the commit outright.
# The backlog no longer "travels" in the public tree; its durable content belongs
# in the private build-loop-memory repo.
/.build-loop/backlog/

# ...but NOT the individual backlog items. This repo is PUBLIC, and
# references/public-repository-documentation-boundary.md §3 denies
# "deferred-work lists" and ".build-loop/ working state". The scaffolding above
# (README, INDEX, .gitattributes) keeps the backlog mechanism discoverable so it
# still "travels"; the item bodies are internal planning and stay private.
# scripts/doc_boundary.py flagged BUILDLOOP-COORD-001.md as a decided violation.
/.build-loop/backlog/items/
!/BACKLOG.md
# NOTE: .codex/ is intentionally TRACKED in this repo — .codex/hooks.json is a
# distributable hook config (Codex Stop/SessionStart → hooks/closeout.sh), the
# Codex-side counterpart to the tracked hooks/hooks.json.

# Runtime memory/state. Durable memory belongs in the private
# build-loop-memory repo, never in this public plugin repo.
.episodic/
.semantic/
.procedural/

# Editor
*.swp
*.swo
*~
.vscode/
.idea/

# Node (if scripts added later)
node_modules/

# Plan artifacts (local only)
docs/superpowers/

# Python cache
__pycache__/
*.pyc

# Python build/venv artifacts
.venv/
.venv*/
*.egg-info/
.pytest_cache/

# Consumer-project artifacts (generated by build-loop runs)
.localsmartz/

# >>> NavGator safety guard (auto-managed)
# These files are regenerated from .env on every NavGator scan and contain
# parsed hostnames/endpoints from your live environment. Credentials are
# stripped by NavGator, but hostnames/project refs still leak infra identity.
# Safe to delete this block if you want the files tracked — NavGator will
# not re-add it while the markers below are missing.
.navgator/architecture/components/COMP_config_*.json
.navgator/architecture/components.full.jsonl
.navgator/architecture/connections.full.jsonl
.navgator/architecture/NAVSUMMARY.md
.navgator/architecture/NAVSUMMARY_FULL.md
.navgator/architecture/SUMMARY.md
.navgator/architecture/SUMMARY_FULL.md
.navgator/dirty.json
.navgator/dirty.d/
.navgator/dirty.lock*
.navgator/scan.lock*
.navgator/architecture/freshness.json.tmp*
# <<< NavGator safety guard

# Build-loop runtime artifacts
.in_use/

# Bookmark snapshot data
.bookmark/

# Private-slug guard runtime config (real slugs — never tracked).
# See .private-slugs.example for the format.
.private-slugs

# Rally coordination is local runtime state. Do not ship room ledgers,
# inboxes, worktree bundles, host/session IDs, or derived caches publicly.
.rally/

# Tool-data directories — never tracked (CLAUDE.md: tool data under .<toolname>/).
# Broadens the NavGator safety guard above to the whole dir — components.full.jsonl
# carries env-parsed hostnames (infra identity). Nothing here is currently tracked.
.navgator/
.ibr/
.spectra/
.claude-code-debugger/
archive/*.bundle
archive/**/*.bundle

# Superseded git bundles — moved to build-loop-memory/archive/build-loop-bundles (GitHub-backed, segmented from package)
archive/

# build-loop experimental artifacts (added by `experimental_ignore.py` — promotion to active/ makes them tracked)
!/.build-loop/skills/
/.build-loop/skills/*
/.build-loop/skills/experimental/
!/.build-loop/skills/active/
!/.build-loop/skills/active/**
!/.build-loop/agents/
/.build-loop/agents/*
/.build-loop/agents/experimental/
!/.build-loop/agents/active/
!/.build-loop/agents/active/**
